# Nginx(공식 이미지가 ${...}를 환경 변수로 채운다). 인증서가 생기기 전에는 http만 쓰는 bootstrap 설정을 쓴다(deploy/README).
server {
    listen 80;
    server_name ${SITE_DOMAIN} ${STORAGE_DOMAIN};
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

# 블로그
server {
    listen 443 ssl;
    http2 on;
    server_name ${SITE_DOMAIN};
    ssl_certificate /etc/letsencrypt/live/${SITE_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SITE_DOMAIN}/privkey.pem;
    client_max_body_size 2m;
    location / {
        proxy_pass http://app:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}

# 사진 저장소(브라우저가 서명된 주소로 직접 올리고 읽는다. 서명 검사에 Host가 그대로 필요)
server {
    listen 443 ssl;
    http2 on;
    server_name ${STORAGE_DOMAIN};
    ssl_certificate /etc/letsencrypt/live/${SITE_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SITE_DOMAIN}/privkey.pem;
    client_max_body_size 25m;
    location / {
        proxy_pass http://storage:9000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_request_buffering off;
    }
}
