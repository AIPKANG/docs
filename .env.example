# 운영 환경 변수 견본. 이 파일을 .env로 복사해 값을 채운다(.env는 git에 올리지 않는다).
# 키 만드는 법: specs/001-auth/secrets-setup.md

# 사이트 주소(메일 링크·OAuth 콜백 기준). 운영은 https://도메인
APP_BASE_URL=http://localhost:8080

# 운영 서버(compose.prod.yaml): 블로그 도메인, 인증서 알림 메일
SITE_DOMAIN=
CERT_EMAIL=

# DB(운영은 NHN 등 관리형이면 DB_URL을 직접)
DB_USERNAME=blog
DB_PASSWORD=

# 메일(Gmail 앱 비밀번호, 띄어쓰기 없이 16자)
MAIL_USERNAME=
MAIL_PASSWORD=

# 소셜 로그인(콜백: {APP_BASE_URL}/login/oauth2/code/google|github)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 사진 저장소: 처음에는 서버 디스크(local). 업로드 주소 서명 키는 긴 무작위 값(예: openssl rand -hex 32)
STORAGE_TYPE=local
STORAGE_LOCAL_SECRET=

# (확장) MinIO로 옮길 때만: STORAGE_TYPE=s3 와 아래 값. DEPLOY.md "사진 저장소 확장"
STORAGE_ENDPOINT=
STORAGE_PRESIGN_ENDPOINT=
STORAGE_PUBLIC_BASE_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_CREATE_BUCKET=false

# AI 태그 추천(비우면 Gemini를 건너뛰고 자체 AI만)
GEMINI_API_KEY=
OLLAMA_BASE_URL=
