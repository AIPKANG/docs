# 운영 환경 변수 견본. 이 파일을 .env로 복사해 값을 채운다(.env는 git에 올리지 않는다).
# 키 만드는 법: specs/001-auth/secrets-setup.md

# 사이트 주소(메일 링크·OAuth 콜백 기준). 운영은 https://도메인
APP_BASE_URL=http://localhost:8080

# DB(운영은 NHN 등 관리형이면 DB_URL을 직접)
DB_USERNAME=blog
DB_PASSWORD=

# 메일(Gmail 앱 비밀번호, 띄어쓰기 없이 16자)
MAIL_USERNAME=
MAIL_PASSWORD=

# 소셜 로그인(콜백: {APP_BASE_URL}/login/oauth2/code/google|github)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 사진 저장소(S3 호환, 운영은 NHN MinIO 앱 전용 키). 내부 주소와 브라우저용 주소가 같으면 PRESIGN은 비워도 된다
STORAGE_ENDPOINT=
STORAGE_PRESIGN_ENDPOINT=
STORAGE_PUBLIC_BASE_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# 버킷을 앱이 만들게 할지(로컬 시험만 true)
STORAGE_CREATE_BUCKET=false

# AI 태그 추천(비우면 Gemini를 건너뛰고 자체 AI만)
GEMINI_API_KEY=
OLLAMA_BASE_URL=
